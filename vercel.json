{
    "version": 2,
    "builds": [
      {
        "src": "app.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
         "dest": "src/server.js",
         "methods":["GET", "POST", "OPTIONS", "PUT", "DELETE"],

        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
       
      }
    ]
  }
  